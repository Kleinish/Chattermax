# ChatterMax persistent storage
#
# Everything defaults under ./data. Individual folders can be moved to
# different disks/shares without changing compose.yaml.

INPUT_MOUNT=./data/input
CORPUS_SOURCES_MOUNT=./data/corpus_sources
CORPUS_CACHE_MOUNT=./data/corpus_cache
DATASET_RAW_MOUNT=./data/dataset_raw
REJECTED_MOUNT=./data/rejected
DATASET_MOUNT=./data/dataset
TRAINING_MOUNT=./data/training
OUTPUT_MOUNT=./data/output
LOGS_MOUNT=./data/logs
REPORTS_MOUNT=./data/reports

# Speech Isolator writes cleaned files directly to INPUT_MOUNT.
SPEECH_CACHE_MOUNT=./data/speech-isolator/cache

# Web UI writes changed settings back to this file.
SETTINGS_FILE_MOUNT=./.env
WEBUI_PORT=8080

VOICE_NAME=zoro
ESPEAK_VOICE=en-us
SAMPLE_RATE=22050

CORPUS_TARGET=20000
MIN_WORDS=2
MAX_WORDS=35

REFERENCE_AUDIO=input/reference.wav
CHATTERBOX_EXAGGERATION=0.20
CHATTERBOX_CFG_WEIGHT=0.50
MAX_GENERATION_ATTEMPTS=4
HF_TOKEN=
TTS_MODEL=turbo

GENERATION_CHUNK_SIZE=2000
GENERATION_MAX_RETRIES=5
GENERATION_RETRY_DELAY=10

WHISPER_MODEL=medium.en
WHISPER_DEVICE=cuda
MIN_ASR_SCORE=92
MIN_DURATION_SEC=0.60
MAX_DURATION_SEC=18.0
MAX_SILENCE_FRACTION=0.50
MAX_CLIPPED_FRACTION=0.0005

BATCH_SIZE=16
NUM_WORKERS=4
VALIDATION_SPLIT=0.03
NUM_TEST_EXAMPLES=100
MAX_EPOCHS=2000
PRECISION=32-true
