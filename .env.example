# Host mount locations ---------------------------------------------------------
# Each path may point to a different local disk or mounted network share.
# Leave the defaults as ./folder to keep data inside this project directory.
# Windows PowerShell examples: D:/ChattyPiper/input or Z:/ChattyPiper/dataset_raw
# WSL examples: /mnt/d/ChattyPiper/input or /mnt/z/ChattyPiper/dataset_raw
INPUT_MOUNT=./input
CORPUS_SOURCES_MOUNT=./corpus_sources
CORPUS_CACHE_MOUNT=./corpus_cache
DATASET_RAW_MOUNT=./dataset_raw
REJECTED_MOUNT=./rejected
DATASET_MOUNT=./dataset
TRAINING_MOUNT=./training
OUTPUT_MOUNT=./output
LOGS_MOUNT=./logs
REPORTS_MOUNT=./reports
SPEECH_INPUT_MOUNT=./speech-isolator/input
SPEECH_OUTPUT_MOUNT=./speech-isolator/output
SPEECH_CACHE_MOUNT=./speech-isolator/cache

# Voice identity / language
VOICE_NAME=zoro
ESPEAK_VOICE=en-us
SAMPLE_RATE=22050

# Corpus builder
CORPUS_TARGET=20000
MIN_WORDS=2
MAX_WORDS=35

# Chatterbox generation
REFERENCE_AUDIO=input/reference.wav
CHATTERBOX_EXAGGERATION=0.20
CHATTERBOX_CFG_WEIGHT=0.50
MAX_GENERATION_ATTEMPTS=4
HF_TOKEN=
TTS_MODEL=turbo

GENERATION_CHUNK_SIZE=2000
GENERATION_MAX_RETRIES=5
GENERATION_RETRY_DELAY=10

# Whisper validation. Good choices: small.en, medium.en, large-v3
WHISPER_MODEL=medium.en
WHISPER_DEVICE=cuda
MIN_ASR_SCORE=92
MIN_DURATION_SEC=0.60
MAX_DURATION_SEC=18.0
MAX_SILENCE_FRACTION=0.50
MAX_CLIPPED_FRACTION=0.0005

# Piper training (true from scratch: no ckpt / no vocoder warmstart)
BATCH_SIZE=16
NUM_WORKERS=4
VALIDATION_SPLIT=0.03
NUM_TEST_EXAMPLES=100
MAX_EPOCHS=2000
PRECISION=32-true

