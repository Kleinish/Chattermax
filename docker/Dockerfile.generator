FROM python:3.11-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONUNBUFFERED=1 \
    APP_ROOT=/app \
    WORKSPACE_ROOT=/app \
    DATA_ROOT=/data

RUN apt-get update && apt-get install -y --no-install-recommends \
      ffmpeg \
      git \
      curl \
      ca-certificates \
      espeak-ng \
      build-essential \
      libsndfile1 \
      sox \
    && rm -rf /var/lib/apt/lists/*

COPY docker/requirements/generator.txt /tmp/requirements.txt

RUN python -m pip install --upgrade pip setuptools wheel \
    && python -m pip install -r /tmp/requirements.txt 

RUN python - <<'PY'
from pathlib import Path

p = Path(
    "/usr/local/lib/python3.11/site-packages/"
    "chatterbox/models/t3/modules/perceiver.py"
)

s = p.read_text()

s = s.replace(
    "import torch",
    "import torch\n"
    "from torch.nn.attention import SDPBackend, sdpa_kernel",
    1
)

old = '''        config = self.flash_config if self.flash_config else {}
        with torch.backends.cuda.sdp_kernel(**config):'''

new = '''        backends = [
            SDPBackend.FLASH_ATTENTION,
            SDPBackend.EFFICIENT_ATTENTION,
            SDPBackend.MATH,
        ]
        with sdpa_kernel(backends):'''

if old not in s:
    raise RuntimeError(
        "Expected Chatterbox SDPA code was not found; "
        "upstream Chatterbox may have changed."
    )

p.write_text(s.replace(old, new))

print("Patched Chatterbox to use torch.nn.attention.sdpa_kernel")
PY

# Replace Chatterbox's pinned Torch/Torchaudio pair with a CUDA 12.8 build.
RUN python -m pip install --no-cache-dir --upgrade --force-reinstall \
      torch==2.9.0 \
      torchaudio==2.9.0 \
      --index-url https://download.pytorch.org/whl/cu128

RUN python -m pip install --no-cache-dir \
      torchcodec==0.9 \
      --index-url https://download.pytorch.org/whl/cpu

# Use the current Perth source to avoid the
# PerthImplicitWatermarker=None failure seen with some packaged versions.
RUN python -m pip uninstall -y resemble-perth perth || true \
    && python -m pip install --no-cache-dir \
      "resemble-perth @ git+https://github.com/resemble-ai/Perth.git@master"

WORKDIR /app

COPY app/scripts/ /app/scripts/
COPY app/web/ /app/web/
COPY assets/ /app/assets/
COPY docker/entrypoint.sh /usr/local/bin/chattermax-entrypoint

RUN chmod +x /usr/local/bin/chattermax-entrypoint \
    && find /app/scripts -type f -name '*.sh' -exec chmod +x {} +

ENTRYPOINT ["/usr/local/bin/chattermax-entrypoint"]

EXPOSE 8080

CMD ["uvicorn", "web.app:app", "--host", "0.0.0.0", "--port", "8080"]
