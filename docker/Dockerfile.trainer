FROM nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONUNBUFFERED=1 \
    APP_ROOT=/app \
    WORKSPACE_ROOT=/app \
    DATA_ROOT=/data

RUN apt-get update && apt-get install -y --no-install-recommends \
    git python3 python3-pip python3-dev build-essential cmake ninja-build \
    espeak-ng libespeak-ng-dev ffmpeg libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --upgrade pip setuptools wheel scikit-build cmake ninja cython

ARG PIPER_VERSION=v1.4.2
RUN git clone --branch ${PIPER_VERSION} --depth 1 \
      https://github.com/OHF-Voice/piper1-gpl.git /opt/piper \
    && cd /opt/piper \
    && python3 -m pip install -e '.[train]' \
    && ./build_monotonic_align.sh \
    && python3 setup.py build_ext --inplace

WORKDIR /app
ENV PYTHONPATH=/opt/piper/src:/opt/piper

COPY app/scripts/ /app/scripts/
COPY config/ /app/config/
COPY docker/entrypoint.sh /usr/local/bin/chattermax-entrypoint

RUN chmod +x /usr/local/bin/chattermax-entrypoint \
    && find /app/scripts -type f -name '*.sh' -exec chmod +x {} +

ENTRYPOINT ["/usr/local/bin/chattermax-entrypoint"]
CMD ["bash"]
